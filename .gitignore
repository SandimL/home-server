# Segredos e ambiente local
.env
.env.*
!.env.example

# Dados de serviços (bind mounts — não versionar)
downloads/
plex/
emqx/
radarr/
prowlarr/
qbittorrent/

# Caddy: certificados, estado e Caddyfile ativo (compose monta só config/caddy/Caddyfile; use *.example versionados)
config/caddy/data/
config/caddy/config/
config/caddy/Caddyfile

# Infra: Vault usa volume Docker; SOPS local (se usares)
infra/secrets/*.enc.yaml
infra/secrets/secrets.yaml
!infra/secrets/*.example

# Logs locais do Homepage (gerados em runtime)
config/homepage/logs/

*.backup
