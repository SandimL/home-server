# Copy to Caddyfile and set IPs, hostnames, and ACME email.
# cp Caddyfile.example Caddyfile
#
# The real Caddyfile should not be committed (.gitignore).
#
# Caddy uses network_mode: host. For services on the same machine, use this host’s
# LAN IP (YOUR_SERVER_LAN_IP) if compose publishes ports on all interfaces (e.g. 7878:7878).
# If you later bind services to 127.0.0.1 only, use 127.0.0.1:PORT as upstream.
#
# *.lan: tls internal for https://name.lan (Let's Encrypt does not issue for .lan).
# Public domains: default automatic HTTPS (Let's Encrypt) without tls internal.

{
	email you@example.com
}

# --- Reverse proxy on the LAN (replace YOUR_SERVER_LAN_IP / OTHER_HOST_IP) ---

plex.lan {
	tls internal
	reverse_proxy YOUR_SERVER_LAN_IP:32400
}

radarr.lan {
	tls internal
	reverse_proxy YOUR_SERVER_LAN_IP:7878
}

prowlarr.lan {
	tls internal
	reverse_proxy YOUR_SERVER_LAN_IP:9696
}

qbittorrent.lan {
	tls internal
	reverse_proxy YOUR_SERVER_LAN_IP:9090
}

netdata.lan {
	tls internal
	reverse_proxy YOUR_SERVER_LAN_IP:19999
}

emqx.lan {
	tls internal
	reverse_proxy YOUR_SERVER_LAN_IP:18083
}

# Portainer: HTTPS on 9443 (self-signed cert)
portainer.lan {
	tls internal
	reverse_proxy https://YOUR_SERVER_LAN_IP:9443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

darubo.lan {
	tls internal
	reverse_proxy YOUR_SERVER_LAN_IP:8000
}

# Proxmox: UI over HTTPS on 8006
proxmox.lan {
	tls internal
	reverse_proxy https://OTHER_HOST_IP:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

ha.lan {
	tls internal
	reverse_proxy OTHER_HOST_IP:8123
}

# --- Public site (e.g. frontend on a published Docker port) ---

example.com {
	reverse_proxy YOUR_SERVER_LAN_IP:5173

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Alternate HTTP port (e.g. access by public IP without a hostname)
:8080 {
	reverse_proxy YOUR_SERVER_LAN_IP:5173

	header {
		X-Content-Type-Options "nosniff"
	}
}
