# Copiar para Caddyfile e ajustar IPs, domínios e email.
# cp Caddyfile.example Caddyfile
#
# O arquivo Caddyfile real não deve ser commitado (está no .gitignore).
#
# Upstream no mesmo host que o Caddy (network_mode: host): use o IP LAN do
# servidor no Docker (ex.: IP_DO_SERVIDOR), desde que as portas dos contentores
# estejam publicadas em todas as interfaces no compose (formato "7878:7878").
# Se no futuro restringir portas só a 127.0.0.1 no docker-compose, o upstream
# tem de ser 127.0.0.1:PORT (o bind loopback não escuta no IP da Ethernet).
#
# *.lan: use tls internal para https://nome.lan (Let's Encrypt não cobre .lan).
# Domínio público (seudominio.com): mantém TLS automático (Let's Encrypt) sem tls internal.

{
	email seu-email@exemplo.com
}

# --- Proxy reverso na LAN (substitua IP_DO_SERVIDOR / IP_OUTRO_HOST) ---

plex.lan {
	tls internal
	reverse_proxy IP_DO_SERVIDOR:32400
}

radarr.lan {
	tls internal
	reverse_proxy IP_DO_SERVIDOR:7878
}

prowlarr.lan {
	tls internal
	reverse_proxy IP_DO_SERVIDOR:9696
}

qbittorrent.lan {
	tls internal
	reverse_proxy IP_DO_SERVIDOR:9090
}

netdata.lan {
	tls internal
	reverse_proxy IP_DO_SERVIDOR:19999
}

emqx.lan {
	tls internal
	reverse_proxy IP_DO_SERVIDOR:18083
}

# Portainer: backend HTTPS na 9443 (cert próprio)
portainer.lan {
	tls internal
	reverse_proxy https://IP_DO_SERVIDOR:9443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

darubo.lan {
	tls internal
	reverse_proxy IP_DO_SERVIDOR:8000
}

# Proxmox: UI em HTTPS na 8006
proxmox.lan {
	tls internal
	reverse_proxy https://IP_OUTRO_HOST:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

ha.lan {
	tls internal
	reverse_proxy IP_OUTRO_HOST:8123
}

# --- Site público (ex.: frontend na porta publicada do Docker) ---

seudominio.com {
	reverse_proxy IP_DO_SERVIDOR:5173

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# HTTP em porta alternativa (ex.: acesso por IP público sem hostname)
:8080 {
	reverse_proxy IP_DO_SERVIDOR:5173

	header {
		X-Content-Type-Options "nosniff"
	}
}
