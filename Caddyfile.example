# Copiar para Caddyfile e ajustar IPs, domínios e email.
# cp Caddyfile.example Caddyfile
#
# O arquivo Caddyfile real não deve ser commitado (está no .gitignore).

{
    email seu-email@exemplo.com
}

# --- Proxy reverso na LAN (substitua IP_DO_SERVIDOR pelo IP do host Docker) ---

plex.lan {
    reverse_proxy IP_DO_SERVIDOR:32400
}

radarr.lan {
    reverse_proxy IP_DO_SERVIDOR:7878
}

qbittorrent.lan {
    reverse_proxy IP_DO_SERVIDOR:9090
}

netdata.lan {
    reverse_proxy IP_DO_SERVIDOR:19999
}

emqx.lan {
    reverse_proxy IP_DO_SERVIDOR:18083
}

portainer.lan {
    reverse_proxy IP_DO_SERVIDOR:9443
}

darubo.lan {
    reverse_proxy IP_DO_SERVIDOR:8000
}

proxmox.lan {
    reverse_proxy IP_OUTRO_HOST:8006
}

ha.lan {
    reverse_proxy IP_OUTRO_HOST:8123
}

# --- Site público (ex.: frontend na porta publicada do Docker) ---

seudominio.com {
    reverse_proxy IP_DO_SERVIDOR:5173 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# HTTP em porta alternativa (ex.: acesso por IP público sem hostname)
:8080 {
    reverse_proxy IP_DO_SERVIDOR:5173
    header {
        X-Content-Type-Options "nosniff"
    }
}
