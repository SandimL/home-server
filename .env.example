# Copy to .env: cp .env.example .env
# Variables substituted in this directory’s docker-compose.yml only.
# The stack includes ../jeronimofestas/docker-compose.yml — that project uses ../jeronimofestas/.env (see its .env.example).

# Cloudflare Tunnel — Zero Trust → Networks → Tunnels → copy token
CLOUDFLARE_TUNNEL_TOKEN=

# EMQX dashboard (initial password; change after first login)
EMQX_DASHBOARD_PASSWORD=change-me

# Plex — https://www.plex.tv/claim/ (one-time claim token)
PLEX_CLAIM=claim-xxxxxxxx
