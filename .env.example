# Copiar para .env: cp .env.example .env

# Let's Encrypt — wildcard *.jeronimofestas.com (Caddy DNS-01)
# Cloudflare → Manage Account → API Tokens → Create Token
# Template "Edit zone DNS" ou: Zone DNS Edit + Zone Zone Read (só a zona jeronimofestas.com)
CLOUDFLARE_DNS_API_TOKEN=

# Cloudflare Tunnel — Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# EMQX Dashboard
EMQX_DASHBOARD_PASSWORD=altere-esta-senha

# Plex — https://www.plex.tv/claim/
PLEX_CLAIM=claim-xxxxxxxx
